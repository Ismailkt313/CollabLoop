# ==============================================================================
# CollabLoop Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the Vite frontend.
# Vite automatically exposes variables prefixed with VITE_ to the client bundle.
# ==============================================================================

# Cloudinary Client Configuration
# 1. Cloud Name: Found on your Cloudinary Dashboard
# 2. Upload Preset: Settings > Upload > Upload presets > set "Signing Mode" to "Unsigned"
# 3. For public cross-browser sync: Settings > Security > Enable 'Resource list'
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional API URL override (leave unset in development so Vite proxies /api to server)
# In production without reverse proxy: VITE_API_URL=https://api.collabloop.com
# VITE_API_URL=
