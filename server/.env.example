# ==============================================================================
# CollabLoop Backend Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the server.
# For local development: defaults are pre-configured.
# For production: generate high-entropy secrets and configure TLS/HTTPS.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port (e.g. 5000 or assigned by cloud host like Railway/Render/AWS)
PORT=5000

# ------------------------------------------------------------------------------
# MongoDB Connection URI
# ------------------------------------------------------------------------------
# Local Development:
MONGODB_URI=mongodb://127.0.0.1:27017/collabloop
# Production (MongoDB Atlas Replica Set):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/collabloop?retryWrites=true&w=majority&appName=CollabLoop

# ------------------------------------------------------------------------------
# Authentication & Session Security
# ------------------------------------------------------------------------------
# In production, use a 256-bit cryptographically secure random string (at least 32 characters).
# Generate using: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-local-secret

# Allowed Client Origin(s) for CORS. In production, use your exact HTTPS domain(s).
# For Vercel frontend: CLIENT_ORIGIN=https://collab-loop.vercel.app
# Multiple origins can be comma-separated: https://collab-loop.vercel.app,http://localhost:2345
CLIENT_ORIGIN=http://localhost:2345

# Cookie Security Flag:
# Set to 'true' in production (requires HTTPS). Set to 'false' for local HTTP development.
COOKIE_SECURE=false

# Cookie SameSite attribute: 'lax', 'strict', or 'none'
# When frontend is on Vercel and backend is on Render (cross-site), use: COOKIE_SAMESITE=none (with COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# Cloudinary Media & Document Storage
# ------------------------------------------------------------------------------
# Required for role media uploads, project thumbnails, and document attachments.
# Obtain from your Cloudinary Console dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# SMTP Email Settings (Optional / Password Reset & Invitations)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CollabLoop <no-reply@collabloop.com>
